<resources>
    <!-- Minimal launch theme; Compose takes over immediately in MainActivity.
         Intentionally not Material3-XML-based to avoid pulling in extra
         non-Compose resource dependencies for a theme that's only visible
         for a single frame before setContent(). -->
    <style name="Theme.AILiveBear" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
